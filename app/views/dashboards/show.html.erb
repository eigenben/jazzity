<section id="search">
  <%= form_tag searches_path do %>
    <%= label_tag :query, "Explore Jazz: " %>
    <%= text_field_tag :query, params[:query], "data-autocomplete" => "/searches/autocomplete" %>
    <%= submit_tag "Go" %>
  <% end %>
</section>

<div id="sidebar"></div>

