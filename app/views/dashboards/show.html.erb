<section class="hero">
  <div class="hero-text">
    <h1 class="hero-title">Jazz theory,<br>in every key.</h1>
    <p class="hero-lede">
      Look up a chord, scale or progression and see it written out on the staff,
      with the scales that fit it and the voicings players reach for.
      Or type the notes you're holding and find out what they spell.
    </p>

    <%= render "searches/form", class: "hero-search", label: "Search chords, scales, progressions or notes", label_class: "visually-hidden" %>
  </div>

  <% if @featured %>
    <%= tag.figure class: "hero-figure", data: player_data(:sequence, @featured.playback, loopable: false) do %>
      <%= voiced_staff(@featured.staff_notes, data: {player_target: "staff"}) %>
      <figcaption>
        <%= link_to "Dm7 G7 Cmaj7", @featured %>, a ii-V-I in rootless voicings
        over the root, voice-led so common tones are held.
        <%= player_button "Hear it", class: "player-button-small" %>
      </figcaption>
    <% end %>
  <% end %>
</section>

<section class="examples" aria-labelledby="examples-heading">
  <h2 id="examples-heading" class="section-heading">Things to try</h2>
  <%= render "searches/examples" %>
</section>

<section aria-labelledby="discover-heading">
  <h2 id="discover-heading" class="section-heading">From the reference</h2>
  <ul class="card-grid card-grid-wide">
    <% @reference.each do |result| %>
      <li><%= render "searches/result", result: result %></li>
    <% end %>
  </ul>
</section>
