<article id="tune">
  <%= render "tunes/header" %>

  <section id="tune-description">
    <%= raw text_to_html(@tune.description) %>
  </section>

  <div id="tune-relateables">
    <% if @tune.tune_progressions.exists? %>
      <section id="tune-progressions">
        <h2>Progressions Used in this Tune:</h2>
        <ul>
          <% @tune.tune_progressions.each do |tune_progression| %>
            <li><%= link_to tune_progression.progression, tune_progression.progression %></li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</article>

<div id="sidebar"></div>
