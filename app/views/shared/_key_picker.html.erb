<%# The keys in a row round the cycle of fourths, with Gb and F# side by side. `path` builds the link for each key, `current` is the key shown (the page's key by default) and `label` names the row. %>
<% current = local_assigns[:current] || @key || Key.default %>

<nav class="key-picker" aria-label="Key">
  <p class="key-picker-label"><%= local_assigns.fetch(:label, "In every key") %></p>
  <ol>
    <% Key.standard.group_by(&:cycle_index).sort.each do |_, keys| %>
      <li<% if keys.many? %> class="key-picker-enharmonic"<% end %>>
        <% keys.each do |key| %>
          <%= link_to key, path.call(key), :aria => {:current => ("page" if key == current)} %>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
