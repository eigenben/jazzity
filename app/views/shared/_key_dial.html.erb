<%# The keys arranged around the circle of fifths, with Gb and F# sharing a place. `path` builds the link for each key, and `current` is the key shown (the page's key by default). %>
<% current = local_assigns[:current] || @key || Key.default %>

<nav class="key-dial" aria-label="Key">
  <p class="key-dial-current">
    <span>Key of</span>
    <strong><%= current %></strong>
  </p>
  <ol>
    <% Key.standard.group_by(&:cycle_index).each do |cycle_index, keys| %>
      <li style="--position: <%= (12 - cycle_index) % 12 %>"<% if keys.many? %> class="key-dial-enharmonic"<% end %>>
        <% keys.each do |key| %>
          <%= link_to key, path.call(key), :aria => {:current => ("page" if key == current)} %>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>
