<%= render "chords/header", key_path: ->(key) { in_key(key, @chord, :voicings) } %>

<%= render "chords/summary" %>

<section class="group" aria-labelledby="voicings-heading">
  <h2 class="section-heading" id="voicings-heading">All voicings</h2>
  <ul class="card-grid card-grid-compact">
    <%= render @voicings, key: @key %>
  </ul>
</section>
