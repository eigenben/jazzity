<% page_description "All #{@voicings.size} piano voicings of #{@chord.short_name} (#{@chord.title}): #{@voicings.map(&:name).to_sentence}, each on the staff and keyboard, ready to play." %>
<%= render "chords/header", page_title: "All #{@chord.short_name} Voicings", key_path: ->(key) { in_key(key, @chord, :voicings) } %>

<%= render "chords/summary" %>

<section class="group" aria-labelledby="voicings-heading">
  <h2 class="section-heading" id="voicings-heading">All voicings</h2>
  <ul class="card-grid card-grid-compact">
    <%= render @voicings, key: @key %>
  </ul>
</section>
