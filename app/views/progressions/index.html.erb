<% content_for :title, "Progressions" %>

<%= render "shared/title", eyebrow: "Reference", title: "Progressions", subtitle: "Common chord movements and the tune forms built from them, with voice-led voicings in any key." %>

<% @progression_families.each do |family| %>
  <section class="group" aria-labelledby="<%= dom_id(family) %>">
    <h2 class="section-heading" id="<%= dom_id(family) %>"><%= family %></h2>
    <ul class="card-grid">
      <%= render family.progressions %>
    </ul>
  </section>
<% end %>
