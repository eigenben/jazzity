<% content_for :title, @progression.title %>

<%= render "shared/title", eyebrow: @progression.progression_family.to_s.presence || "Progression", title: @progression.title, subtitle: @progression.summary %>

<div class="with-dial">
  <div class="main-column">
    <section class="feature" aria-label="Chart">
      <% if (chart = @progression.lead_sheet) %>
        <%= render "progressions/lead_sheet", chart: chart %>
      <% end %>
      <% if @voiced_chords.any? %>
        <%= voiced_staff(@progression.staff_notes(@voiced_chords), beats_per_bar: @progression.beats_per_bar, class: "staff-large") %>
      <% end %>
      <% facts = {"Meter" => @progression.meter, "Form" => @progression.form, "Bars" => @progression.bars}.compact %>
      <% if facts.any? %>
        <dl class="facts">
          <% facts.each do |term, value| %>
            <div><dt><%= term %></dt><dd><%= value %></dd></div>
          <% end %>
        </dl>
      <% end %>
      <% if @progression.information.present? %>
        <div class="prose">
          <%= text_to_html @progression.information %>
        </div>
      <% end %>
    </section>

    <% if @progression.chords.any? %>
      <%= render "progressions/voice_leading", voiced_chords: @voiced_chords %>
    <% end %>

    <% if @progression.changes.many? %>
      <%= render "progressions/reharmonize", progression: @progression %>
    <% end %>

    <% if (variations = @progression.variations).any? %>
      <section class="group" aria-labelledby="variations-heading">
        <h2 class="section-heading" id="variations-heading">Variations</h2>
        <ul class="card-grid">
          <%= render variations %>
        </ul>
      </section>
    <% end %>
  </div>

  <%= render "shared/key_dial", path: ->(key) { polymorphic_path(in_key(key, @progression), voicing_params) } %>
</div>
