<% content_for :title, @progression.title %>

<%= render "shared/title", eyebrow: @progression.progression_family.to_s.presence || "Progression", title: @progression.title, subtitle: links_to_chords(@progression.chords, " ") %>

<div class="with-dial">
  <div class="main-column">
    <section class="feature">
      <%= staff_tag(@staff_notes, clef: :grand, barlines: true, class: "staff-large") %>
      <% facts = {"Meter" => @progression.meter, "Form" => @progression.form, "Bars" => @progression.bars}.compact %>
      <% if facts.any? %>
        <dl class="facts">
          <% facts.each do |term, value| %>
            <div><dt><%= term %></dt><dd><%= value %></dd></div>
          <% end %>
        </dl>
      <% end %>
      <% if @progression.summary.present? || @progression.information.present? %>
        <div class="prose">
          <p><%= @progression.summary %></p>
          <%= text_to_html @progression.information %>
        </div>
      <% end %>
    </section>

    <%= render "progressions/voice_leading", chords: @progression.chords %>
  </div>

  <%= render "shared/key_dial", path: ->(key) { in_key(key, @progression) } %>
</div>
