<% content_for :title, @progression.title %>

<%= render "shared/title", eyebrow: @progression.progression_family.to_s.presence || "Progression", title: @progression.title, subtitle: @progression.summary,
      key_path: ->(key) { polymorphic_path(in_key(key, @progression), voicing_params) } %>

<%= tag.section class: "feature", aria: {label: "Chart"}, data: progression_player_data(@progression, @voiced_chords) do %>
  <% if @voiced_chords.any? %>
    <%= render "players/transport", next_key: true, practice_path: polymorphic_path(in_key(@key, @progression), {:action => :practice}.merge(voicing_params)) %>
  <% end %>
  <% if (chart = @progression.lead_sheet) %>
    <%= render "progressions/lead_sheet", chart: chart %>
  <% end %>
  <% if @progression.chords.any? %>
    <%= render "progressions/voice_leading", voiced_chords: @voiced_chords %>
  <% end %>
  <% if @voiced_chords.any? %>
    <%= voiced_staff(@progression.staff_notes(@voiced_chords), beats_per_bar: @progression.beats_per_bar, max_bars_per_line: 8, min_bar_width: 140, class: "staff-large staff-score", data: {player_target: "staff"}) %>
    <%= render "players/keyboard", voiced_chords: @voiced_chords %>
  <% end %>
  <% home_key = (link_to(@progression.home_key, in_key(@progression.home_key, @progression)) if @progression.home_key_name) %>
  <% facts = {"Meter" => @progression.meter, "Form" => @progression.form, "Bars" => @progression.bars, "Usual key" => home_key}.compact %>
  <% if facts.any? %>
    <dl class="facts">
      <% facts.each do |term, value| %>
        <div><dt><%= term %></dt><dd><%= value %></dd></div>
      <% end %>
    </dl>
  <% end %>
  <% if @progression.information.present? %>
    <div class="prose">
      <%= text_to_html @progression.information %>
    </div>
  <% end %>
<% end %>

<% if @progression.changes.many? %>
  <%= render "progressions/reharmonize", progression: @progression %>
<% end %>

<% if (variations = @progression.variations).any? %>
  <section class="group" aria-labelledby="variations-heading">
    <h2 class="section-heading" id="variations-heading">Variations</h2>
    <ul class="card-grid">
      <%= render variations %>
    </ul>
  </section>
<% end %>
