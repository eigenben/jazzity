<h2><%= model.title %></h2>
<cite>by <%= model.composer %></cite>

<ul class="attributes">
  <% if model.style? %>
    <li><%= model.style %></li>
  <% end %>
  <% if model.meter %>
    <li><%= model.meter %></li>
  <% end %>
  <% if model.primary_key %>
    <li>
      in
      <%= model.primary_key %>
      <%= model.tonality %>
      <%= " (Also #{model.secondary_key})" if model.secondary_key %>
    </li>
  <% end %>
  <% if model.form %>
    <li>
      <%= model.form %>
      <%= "#{model.form_length} Bars" if model.form_length %>
      <%= model.form_lengths if model.form_lengths %>
    </li>
  <% end %>
</ul>
