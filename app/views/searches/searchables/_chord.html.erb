<div class="staff chord-staff" data-id="<%= model.id %>" data-staff='<%= model.octavized_notes.to_json %>' data-staff-clef="treble" width="150" data-scale="0.8"></div>
<h2><%= "#{model.title} Chord" %></h2>
<p><%= model.notes.join(", ") %></p>
<p>
  <%= model.main_symbol_name %>
  <% if model.other_symbol_names.present? %>
    <span>(Also: <%= model.other_symbol_names.join(', ') %>)</span>
  <% end %>
</p>
<p>
  <label>Intervals:</label>
  <%= model.interval_names.join(", ") %>
</p>
