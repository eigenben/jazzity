<%= tag.article class: "scale-entry playable", id: dom_id(scale), data: player_data(:scale, playback_for(scale).first) do %>
  <div class="scale-entry-text">
    <h2 class="scale-entry-title"><%= link_to scale.name, scale %></h2>
    <% if scale.information.present? %>
      <p><%= scale.information %></p>
    <% end %>
    <% if scale.modes.many? %>
      <ul class="chips" aria-label="Modes of <%= scale.name %>">
        <% scale.modes.each do |mode| %>
          <li><%= link_to mode.name, [scale, mode] %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
  <%= scale_staff(scale) %>
  <%= play_button "Play the #{scale.name} scale" %>
<% end %>
