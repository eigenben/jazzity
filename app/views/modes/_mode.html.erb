<%# A mode as a card, in `key` (the key of its parent scale) when given, and labelled `kind` when given rather than by its scale. Only a scale's first mode repeats the scale's information. %>
<% mode = mode.in_key_of(key) if local_assigns[:key] %>

<%= tag.li id: dom_id(mode), class: "playable", data: player_data(:scale, playback_for(mode).first) do %>
  <%= link_to in_key(local_assigns[:key], mode.scale, (mode unless mode.main?)), class: "card" do %>
    <% if local_assigns[:kind] %>
      <p class="card-kind card-kind-cased"><%= kind %></p>
    <% else %>
      <p class="card-kind">Mode of <%= mode.scale.name %></p>
    <% end %>
    <h3 class="card-title"><%= mode.title %></h3>
    <%= scale_staff(mode) %>
    <% if (information = mode[:information].presence || (mode.scale.information if mode.main?)) %>
      <p class="card-meta"><%= truncate information, length: 90 %></p>
    <% elsif local_assigns[:kind] %>
      <p class="card-meta">Mode <%= mode.mode %> of <%= mode.scale.name %></p>
    <% end %>
  <% end %>
  <%= play_button "Play #{mode.title}" %>
<% end %>
