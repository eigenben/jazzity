<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "Jazzity"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% description = "Explore jazz chords, scales, voicings and progressions in every key, written out in staff notation." %>
    <meta name="description" content="<%= description %>">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#0f2d63">

    <%# The link preview in iMessage, Slack and the like. The card's source is docs/og. %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Jazzity">
    <meta property="og:title" content="<%= content_for(:title) || "Jazzity: jazz theory, in every key" %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:url" content="<%= request.base_url + request.path %>">
    <meta property="og:image" content="<%= request.base_url %>/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Jazzity: jazz theory, in every key. A ii-V-I written out on the staff.">
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:ital,wght@0,400;0,600;1,400&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body>
    <%# The masthead and the page's title share the midnight band, like the front of a record sleeve; the page's first panel overlaps its foot. %>
    <div class="band">
      <header class="masthead">
        <div class="masthead-inner">
          <%= link_to root_path, class: "wordmark" do %><%= render "shared/logo_mark" %>Jazzity<% end %>
          <nav class="primary-nav" aria-label="Sections">
            <%= navigation_link_to "Chords", chords_path, [ChordsController, VoicingsController] %>
            <%= navigation_link_to "Scales", scales_path, [ScalesController, ModesController] %>
            <%= navigation_link_to "Progressions", progressions_path, [ProgressionsController] %>
            <%= navigation_link_to "Analyze", analysis_path, [AnalysesController, ChordSequencesController] %>
          </nav>
          <% unless controller.is_a?(DashboardsController) %>
            <%= render "searches/form", class: "masthead-search", label_class: "visually-hidden" %>
          <% end %>
        </div>
      </header>

      <%= yield :band %>

      <% flash.each do |type, message| %>
        <p class="flash flash-<%= type %>" role="status"><%= message %></p>
      <% end %>
    </div>

    <main class="page">
      <%= yield %>
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <%= link_to root_path, class: "wordmark wordmark-small" do %><%= render "shared/logo_mark" %>Jazzity<% end %>
        <div class="colophon-credits">
          <p>A jazz theory reference by <%= link_to "Ben Hughes", "https://eigenben.com" %>.</p>
          <%= link_to "https://github.com/eigenben/jazzity", class: "colophon-source" do %>Source on GitHub <span aria-hidden="true">↗</span><% end %>
        </div>
      </div>
    </footer>
  </body>
</html>
