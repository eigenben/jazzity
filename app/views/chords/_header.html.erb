<header>
  <h1>
    <%= link_to_unless_current "#{@chord.title} Chord:", [@key, @chord] %>
    <%= @chord.main_symbol_name %>
    <% if @chord.other_symbol_names.present? %>
      <span>(Also: <%= @chord.other_symbol_names.join(', ') %>)</span>
    <% end %>
  </h1>

  <p><%= @chord.information %></p>
  <% if @chord.parent %>
    <p>
      <label>Parent Chord:</label>
      <%= link_to @chord.parent, [@key, @chord.parent] %>
    </p>
  <% end %>
  <p>
    <label>Intervals:</label>
    <%= @chord.interval_names.join(", ") %>
  </p>
  <h3><%= @chord.notes.join(", ") %></h3>

  <div class="staff chord-staff" data-id="<%= @chord.id %>" data-staff='<%= @chord.octavized_notes.to_json %>' data-staff-clef="treble" width="150"></div>
</header>
