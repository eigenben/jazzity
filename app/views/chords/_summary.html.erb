<% chords, hands = playback_for(@chord) %>
<%= tag.section class: "feature feature-split", data: player_data(:chord, chords, shortcut: true) do %>
  <%= render "players/controls", play_label: "Play chord" %>
  <%= chord_staff(@chord, class: "staff-large") %>
  <%= keyboard_tag(hands[:right], data: {player_target: "keyboard"}) %>
  <dl class="facts">
    <div class="facts-wide">
      <dt>Notes and intervals</dt>
      <dd><%= note_tiles(@chord.notes, intervals: @chord.interval_names, root: true) %></dd>
    </div>
    <% if @chord.parent %>
      <div>
        <dt>Extends</dt>
        <dd><%= link_to @chord.parent.in_key_of(@chord.key).title, in_key(@chord.key, @chord.parent) %></dd>
      </div>
    <% end %>
  </dl>
  <% about = (render "chords/about", chord: @chord if local_assigns[:about]) %>
  <% if @chord.information.present? || about.present? %>
    <div class="prose"><%= text_to_html @chord.information if @chord.information.present? %><%= about %></div>
  <% end %>
<% end %>
