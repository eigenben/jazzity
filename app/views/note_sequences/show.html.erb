<article id="note-sequence">
  <header>
    <h1>
      Note Sequence:
      <%= @note_sequence.title %>
    </h1>
  </header>

  <nav id="key-selector">
    <h2>Key:</h2>
    <ul>
      <% Key.primaries.each do |key| %>
        <li class="<%= "current" if @key == key %>">
          <%= link_to_unless @key == key, key, [key, @note_sequence] %>
        </li>
      <% end %>
    </ul>
  </nav>

  <section id="staff">
    <div class="staff chord-staff" data-staff='<%= @note_sequence.octavized_notes.to_json %>' data-staff-clef="treble"></div>
  </section>

  <% unless @note_sequence.chords.empty? %>
    <nav class="related-chords">
      <h3>Related Chords:</h3>
      <ul class="chords-list">
        <%= render @note_sequence.chords %>
      </ul>
    </nav>
  <% end %>

  <% unless @note_sequence.modes.empty? %>
    <nav class="related-modes">
      <h3>Related Scales:</h3>
      <ul class="modes-list">
        <%= render @note_sequence.modes %>
      </ul>
    </nav>
  <% end %>
</article>
