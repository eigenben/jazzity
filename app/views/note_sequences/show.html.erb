<% content_for :title, @note_sequence.title %>

<%= render "shared/title", eyebrow: "Notes", title: @note_sequence.name,
      key: @note_sequence.home_key, key_path: ->(key) { @note_sequence.in_key_of(key) } %>

<% chords, hands = playback_for(@note_sequence) %>
<%= tag.section class: "feature", data: player_data(:chord, chords, shortcut: true) do %>
  <%= render "players/controls", play_label: "Play notes" %>
  <%= staff_tag([@note_sequence.octavized_notes], class: "staff-large") %>
  <%= keyboard_tag(hands[:right], data: {player_target: "keyboard"}) %>
<% end %>

<% if @note_sequence.chords.any? %>
  <section class="group" aria-labelledby="chords-heading">
    <h2 class="section-heading" id="chords-heading">Chords these notes spell</h2>
    <ul class="card-grid card-grid-compact">
      <%= render @note_sequence.chords %>
    </ul>
  </section>
<% else %>
  <p class="empty">These notes don't spell a chord Jazzity knows. Check the spelling, or try fewer notes.</p>
<% end %>

<% if @note_sequence.modes.any? %>
  <section class="group" aria-labelledby="scales-heading">
    <h2 class="section-heading" id="scales-heading">Scales that contain them</h2>
    <ul class="card-grid card-grid-wide">
      <% @note_sequence.modes.each do |mode| %>
        <%= render mode, key: mode.key %>
      <% end %>
    </ul>
  </section>
<% end %>
