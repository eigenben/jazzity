<article id="chord-sequence">
  <header>
    <h1>
      Chord Sequence:
      <%= @chord_sequence.title %>
    </h1>
  </header>

  <nav id="key-selector">
    <h2>Key:</h2>
    <ul>
      <% Key.primaries.each do |key| %>
        <li class="<%= "current" if @key == key %>">
          <%= link_to_unless @key == key, key, [key, @chord_sequence] %>
        </li>
      <% end %>
    </ul>
  </nav>

  <section id="staff">
    <div class="staff progression-staff" data-staff='<%= @staff_notes.to_json %>' data-clef="treble,bass" height="160"></div>
  </section>

  <section id="voice-leading">
    <%= form_tag({}, method: :get) do %>
      <h2>Voice Leading:</h2>
      <ul>
        <% @chord_sequence.chords.each_with_index do |chord, i| %>
          <li>
            <%= chord.short_name %>
            (<%= select_tag("v[#{i}]", voice_leading_options_for_select(chord, i)) %>)
          </li>
        <% end %>
      </ul>
      <%= submit_tag "Update Voicings", name: nil %>
    <% end %>
  </section>

  <nav class="related-progressions">
    <h3>Related Progressions:</h3>
    <ul class="progressions-list">
      <%= render @chord_sequence.progressions %>
    </ul>
  </nav>
</article>
