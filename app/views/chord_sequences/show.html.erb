<% content_for :title, @chord_sequence.title %>

<%= render "shared/title", eyebrow: "Chord sequence", title: @chord_sequence.name, subtitle: links_to_chords(@chord_sequence.chords, " ") %>

<div class="with-dial">
  <div class="main-column">
    <section class="feature">
      <%= voiced_staff(@chord_sequence.staff_notes(@voiced_chords), class: "staff-large") %>
    </section>

    <%= render "progressions/voice_leading", chords: @chord_sequence.chords %>

    <% if (progressions = @chord_sequence.progressions).any? %>
      <section class="group" aria-labelledby="progressions-heading">
        <h2 class="section-heading" id="progressions-heading">Known progressions</h2>
        <ul class="card-grid">
          <%= render progressions %>
        </ul>
      </section>
    <% end %>
  </div>

  <%= render "shared/key_dial", path: ->(key) { in_key(key, @chord_sequence) } %>
</div>
