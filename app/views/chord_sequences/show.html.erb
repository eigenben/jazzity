<% content_for :title, @chord_sequence.title %>

<%= render "shared/title", eyebrow: "Chord sequence", title: @chord_sequence.name, subtitle: links_to_chords(@chord_sequence.chords, " ", lead_sheet: true) %>

<div class="with-dial">
  <div class="main-column">
    <%= tag.section class: "feature", data: chord_sequence_player_data(@chord_sequence, @voiced_chords) do %>
      <%= render "players/transport", next_key: true %>
      <%= voiced_staff(@chord_sequence.staff_notes(@voiced_chords), class: "staff-large", data: {player_target: "staff"}) %>
      <%= render "players/keyboard", voiced_chords: @voiced_chords %>
    <% end %>

    <%= render "chord_sequences/analysis", sequence: @chord_sequence %>

    <%= render "progressions/voice_leading", voiced_chords: @voiced_chords %>
  </div>

  <%= render "shared/key_dial", current: @chord_sequence.home_key, path: ->(key) { polymorphic_path(in_key(key, @chord_sequence.in_key_of(key)), voicing_params) } %>
</div>
