<% content_for :title, @chord_sequence.title %>

<%= render "shared/title", eyebrow: "Chord sequence", title: @chord_sequence.name, subtitle: links_to_chords(@chord_sequence.chords, " ") %>

<div class="with-dial">
  <div class="main-column">
    <section class="feature">
      <%= voiced_staff(@chord_sequence.staff_notes(@voiced_chords), class: "staff-large") %>
    </section>

    <%= render "chord_sequences/analysis", sequence: @chord_sequence %>

    <%= render "progressions/voice_leading", voiced_chords: @voiced_chords %>
  </div>

  <%= render "shared/key_dial", current: @chord_sequence.home_key, path: ->(key) { polymorphic_path(in_key(key, @chord_sequence.in_key_of(key)), voicing_params) } %>
</div>
